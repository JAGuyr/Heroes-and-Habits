rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - name: string (required)
    //   - userType: string ('parent' or 'child') (required)
    //   - parentId: string (optional, for children)
    //   - totalPointsBalance: number (required)
    //   - lifetimePoints: number (required)
    //   - lifetimeTasksCompleted: number (required)
    //   - xp: number (required)
    //   - level: number (required)
    //   - parentPin: string (optional, 4-digit)
    //
    // Collection: users/{userId}/habits
    // Document ID: {habitId}
    // Fields:
    //   - name: string (required)
    //   - description: string
    //   - points: number (required)
    //   - xp: number (required)
    //   - icon: string
    //   - streak: number
    //   - lastCompleted: string (ISO date)
    //   - category: string (Quest, Daily, Skill)
    //   - requiresApproval: boolean
    //   - parentId: string
    //
    // Collection: users/{userId}/completions
    // Document ID: {completionId}
    // Fields:
    //   - habitId: string (required)
    //   - habitName: string
    //   - date: string (ISO date) (required)
    //   - timestamp: string (ISO date-time) (required)
    //   - pointsEarned: number (required)
    //   - xpEarned: number (required)
    //   - status: string ('pending', 'approved') (required)
    //   - childId: string (required)
    //   - childName: string (required)
    //   - parentId: string (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "JAGuyr@gmail.com" && request.auth.token.email_verified == true));
    }

    function isRecent(timestamp) {
      return timestamp is timestamp && 
             timestamp > request.time - duration.value(5, 'm') &&
             timestamp < request.time + duration.value(5, 'm');
    }

    function isValidUserStats(data) {
      return data.keys().hasAll(['name', 'userType', 'totalPointsBalance', 'lifetimePoints', 'lifetimeTasksCompleted', 'xp', 'level']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.userType in ['parent', 'child'] &&
             data.totalPointsBalance is int &&
             data.lifetimePoints is int &&
             data.lifetimeTasksCompleted is int &&
             data.xp is int &&
             data.level is int &&
             (!('parentPin' in data) || (data.parentPin is string && data.parentPin.matches('^[0-9]{4}$'))) &&
             (!('role' in data) || data.role in ['admin', 'user']);
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['name', 'points', 'xp', 'parentId', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.points is int && data.points >= 0 &&
             data.xp is int && data.xp >= 0 &&
             data.parentId is string &&
             (!('category' in data) || data.category in ['Quest', 'Daily', 'Skill']) &&
             (!('requiresApproval' in data) || data.requiresApproval is bool) &&
             (!('description' in data) || (data.description is string && data.description.size() < 500));
    }

    function isValidCompletionLog(data) {
      return data.keys().hasAll(['habitId', 'date', 'timestamp', 'pointsEarned', 'xpEarned', 'status', 'childId', 'childName', 'parentId']) &&
             data.habitId is string &&
             data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
             data.timestamp is string &&
             data.pointsEarned is int &&
             data.xpEarned is int &&
             data.status in ['pending', 'approved'] &&
             data.childId is string &&
             data.childName is string && data.childName.size() < 100 &&
             data.parentId is string;
    }

    function isValidReward(data) {
      return data.keys().hasAll(['title', 'pointCost', 'parentId', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.pointCost is int && data.pointCost >= 0 &&
             data.parentId is string &&
             (!('description' in data) || (data.description is string && data.description.size() < 500));
    }

    // Rules
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin() || request.resource.data.parentId == request.auth.uid) && isValidUserStats(request.resource.data);
      allow update: if (isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.parentId == request.auth.uid)) && isValidUserStats(request.resource.data);

      match /habits/{habitId} {
        allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && (resource.data.parentId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid));
        allow create: if (isOwner(userId) || isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid)) && isValidHabit(request.resource.data);
        allow update, delete: if isOwner(userId) || isAdmin() || (isAuthenticated() && (resource.data.parentId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid));
      }

      match /completions/{completionId} {
        allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid);
        allow create: if (isOwner(userId) || isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid)) && isValidCompletionLog(request.resource.data);
        allow update: if (isAdmin() || (isAuthenticated() && (resource.data.parentId == request.auth.uid || get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid))) && isValidCompletionLog(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(userId)).data.parentId == request.auth.uid);
      }
    }

    match /{path=**}/completions/{completionId} {
      allow read: if isAuthenticated() && (resource.data.parentId == request.auth.uid || resource.data.childId == request.auth.uid || isAdmin());
    }

    match /rewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'parent') && isValidReward(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || resource.data.parentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'parent') && isValidReward(request.resource.data);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.parentId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'parent');
    }

    // Connection test path
    match /test/connection {
      allow read: if true;
    }
  }
}
